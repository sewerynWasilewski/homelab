{
  "title": "MinIO",
  "uid": "minio",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cluster Health",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "minio_cluster_health_status", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Unhealthy", "color": "red" }, "1": { "text": "Healthy", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodes Online",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "sum(minio_cluster_nodes_online_total)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Nodes Offline",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "sum(minio_cluster_nodes_offline_total) OR on() vector(0)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Drives Online / Offline",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "sum(minio_cluster_drive_online_total)", "legendFormat": "online", "refId": "A" },
        { "expr": "sum(minio_cluster_drive_offline_total) OR on() vector(0)", "legendFormat": "offline", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Buckets",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "sum(minio_cluster_bucket_total)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Objects",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "sum(minio_cluster_usage_object_total)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Capacity",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Raw Capacity Usage %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        {
          "expr": "(1 - (minio_cluster_capacity_raw_free_bytes / minio_cluster_capacity_raw_total_bytes)) * 100",
          "legendFormat": "{{server}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cluster Usage (GB)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "minio_cluster_usage_total_bytes", "legendFormat": "{{server}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "decbytes", "min": 0 }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "row",
      "title": "S3 Requests",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Requests by API (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "sum by (api) (rate(minio_s3_requests_total[5m]))", "legendFormat": "{{api}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Errors by API (rate)",
      "description": "4xx/5xx S3 responses per API call - some baseline rate of client-side 4xx (e.g. HeadObject on a missing key) is normal, not itself a problem.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "sum by (api) (rate(minio_s3_requests_errors_total[5m]))", "legendFormat": "{{api}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "S3 Traffic",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "rate(minio_s3_traffic_received_bytes[5m])", "legendFormat": "{{server}} received", "refId": "A" },
        { "expr": "-(rate(minio_s3_traffic_sent_bytes[5m]))", "legendFormat": "{{server}} sent", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": { "fillOpacity": 20, "gradientMode": "opacity", "lineWidth": 1 }
        },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "/.*received.*/" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byRegexp", "options": "/.*sent.*/" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Node Process",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "CPU Usage (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "rate(minio_node_process_cpu_total_seconds[5m]) * 100", "legendFormat": "{{server}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0 }, "overrides": [] }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Memory Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "minio_node_process_resident_memory_bytes", "legendFormat": "{{server}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "decbytes", "min": 0 }, "overrides": [] }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Open File Descriptors",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "minio_node_file_descriptor_open_total", "legendFormat": "{{server}} open", "refId": "A" },
        { "expr": "minio_node_file_descriptor_limit_total", "legendFormat": "{{server}} limit", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Goroutines",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "targets": [
        { "expr": "minio_node_go_routine_total", "legendFormat": "{{server}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] }
    }
  ]
}
