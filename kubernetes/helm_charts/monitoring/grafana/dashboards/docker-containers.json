{
  "title": "Docker Containers",
  "uid": "docker-containers",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(container_last_seen{k8s_cluster=\"\"}, host)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Container CPU Usage",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (host, instance, image) (rate(container_cpu_usage_seconds_total{host=~\"$host\", k8s_cluster=\"\", id!=\"/\"}[5m]))",
          "legendFormat": "{{instance}}/{{image}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Container Memory Usage",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (host, instance, image) (container_memory_working_set_bytes{host=~\"$host\", k8s_cluster=\"\", id!=\"/\"})",
          "legendFormat": "{{instance}}/{{image}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Host Network I/O (per interface)",
      "description": "cAdvisor doesn't attribute network stats to individual containers on standalone Docker - only to the host's own network interfaces (bridges, physical NIC). Per-container network breakdown isn't available here.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (host, instance, interface) (rate(container_network_receive_bytes_total{host=~\"$host\", k8s_cluster=\"\", id=\"/\"}[5m]))",
          "legendFormat": "{{instance}}/{{interface}} rx",
          "refId": "A"
        },
        {
          "expr": "-(sum by (host, instance, interface) (rate(container_network_transmit_bytes_total{host=~\"$host\", k8s_cluster=\"\", id=\"/\"}[5m])))",
          "legendFormat": "{{instance}}/{{interface}} tx",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*rx.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/.*tx.*/"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}