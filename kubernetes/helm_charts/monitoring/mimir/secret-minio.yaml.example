apiVersion: v1
kind: Secret
metadata:
  name: mimir-minio-credentials
  namespace: monitoring
type: Opaque
stringData:
  # Scoped MinIO user (policy limited to the mimir-* buckets only), not the
  # MinIO root account - created via:
  #   mc admin user add local mimir <password>
  #   mc admin policy create local mimir-policy <policy scoped to mimir-* buckets>
  #   mc admin policy attach local mimir-policy --user mimir
  MINIO_ACCESS_KEY_ID: mimir
  MINIO_SECRET_ACCESS_KEY: REPLACE_ME
