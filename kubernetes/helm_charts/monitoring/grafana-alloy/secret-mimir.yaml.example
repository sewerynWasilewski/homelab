apiVersion: v1
kind: Secret
metadata:
  name: alloy-mimir-credentials
  namespace: monitoring
type: Opaque
stringData:
  # Traefik basicAuth password for the "homelab" tenant on
  # mimir.swasilewski.pl - see docker/lb/dynamic/mimir.yml. Revoke by
  # deleting that user's line there and reloading Traefik; this value then
  # stops working immediately.
  MIMIR_PASSWORD: REPLACE_ME
