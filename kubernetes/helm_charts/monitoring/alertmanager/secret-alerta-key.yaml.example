apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-alerta-key
  namespace: monitoring
type: Opaque
stringData:
  # write:webhooks + write:alerts scoped key, created via:
  #   kubectl exec -n monitoring deploy/alerta-alerta -- alertad key \
  #     --username <admin-email> --scope write:webhooks --scope write:alerts \
  #     --text "alertmanager webhook"
  alerta-api-key: REPLACE_ME
