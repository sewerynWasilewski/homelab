PM_API_TOKEN_ID=
PM_API_TOKEN_SECRET=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=

PG_CONN_STR=

# --- Kubernetes secrets (homelab cluster) - applied by kubernetes/scripts/apply-secrets.sh ---
K8S_ALERTA_DATABASE_URL=
K8S_ALERTMANAGER_ALERTA_API_KEY=
K8S_ALERTMANAGER_GOALERT_WEBHOOK_URL=
K8S_GOALERT_DATABASE_URL=
K8S_GOALERT_DATA_ENCRYPTION_KEY=
K8S_ALLOY_MIMIR_PASSWORD=
K8S_GRAFANA_ADMIN_USER=
K8S_GRAFANA_ADMIN_PASSWORD=
K8S_MIMIR_MINIO_ACCESS_KEY_ID=
K8S_MIMIR_MINIO_SECRET_ACCESS_KEY=
K8S_ONCALL_POSTGRESQL_PASSWORD=
K8S_ONCALL_RABBITMQ_USERNAME=
K8S_ONCALL_RABBITMQ_PASSWORD=
K8S_REGISTRY_SERVER=
K8S_REGISTRY_USERNAME=
K8S_REGISTRY_PASSWORD=

# --- Traefik basicAuth (proxy VM, /root/traefik/auth/*.htpasswd) + Alloy remote_write ---
# Alloy on proxy/services/proxmox reads MIMIR_PASSWORD from /etc/default/alloy.
# TRAEFIK_MIMIR_HOMELAB_PASSWORD must equal K8S_ALLOY_MIMIR_PASSWORD.
TRAEFIK_ALERTMANAGER_ADMIN_PASSWORD=
TRAEFIK_MIMIR_HOMELAB_PASSWORD=

# --- Terraform state backend (MinIO bucket "tfstate", user "tfstate") ---
# Also in ~/.aws/credentials as profile [homelab-tfstate], which the backends use.
TF_STATE_ACCESS_KEY_ID=
TF_STATE_SECRET_ACCESS_KEY=
