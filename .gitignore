# macOS
.DS_Store

# env (all credentials, see kubernetes/SECRETS.md); .env.example is committed
.env

# keys / credentials (store locally in keys/, never commit)
keys/*
!keys/.gitkeep

# terraform
*.tfstate
*.tfstate.*
.terraform/
*.tfvars

artifacts/

# skipped for now, not ready to publish
docs/
archive/

# docker-compose runtime data and credential files - never commit these,
# only the docker-compose.yml/config that describes them
hosts/*/*/data/
hosts/*/*/auth/
hosts/*/data/

# Safety net: real credentials live only in the root .env (see
# kubernetes/SECRETS.md). Never commit ad-hoc secret manifests/values.
secret-*.yaml
values.secrets.yaml
# Traefik basicAuth users files (generated from .env, live only on proxy VM)
hosts/proxy/traefik/auth/
